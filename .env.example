# Server-only Gemini credentials. Configure in Netlify Functions / server environment.
# Never prefix this with VITE_ and never expose it to browser code.
GEMINI_API_KEY=""

# Optional model override used by the Express / Netlify Functions runtime.
GEMINI_MODEL="gemini-4-hydrogen"

# Public Supabase browser configuration (both AI Studio preview & Netlify production).
# Set these in AI Studio environment / .env.local (uncommitted) and in Netlify Build env.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Backward compatibility only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=""

# Server-side Supabase validation variables (used by Netlify Functions & Express server).
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Optional allow-list for additional social providers (comma-separated).
# Supabase's live Auth provider settings remain the final authority for whether OAuth works.
VITE_SUPABASE_ENABLED_PROVIDERS="google,github,apple,azure,discord"
