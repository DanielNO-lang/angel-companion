# Server-only Gemini credentials. Configure in Netlify Functions / server environment.
# Never prefix this with VITE_ and never expose it to browser code.
GEMINI_API_KEY=""

# Optional model override used by the Netlify Functions runtime.
GEMINI_MODEL="gemini-3.8-flash"

# Public Supabase browser configuration.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Backward compatibility only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=""

# Optional allow-list for additional social providers. Google is the first-class provider;
# Supabase's own Auth provider configuration is the final authority for whether OAuth works.
VITE_SUPABASE_ENABLED_PROVIDERS="github,apple,azure,discord"
